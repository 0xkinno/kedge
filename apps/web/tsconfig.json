{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "ethers": [
        "./node_modules/ethers"
      ],
      "@polkadot/api": [
        "./node_modules/@polkadot/api"
      ],
      "@polkadot/util": [
        "./node_modules/@polkadot/util"
      ],
      "@polkadot/util-crypto": [
        "./node_modules/@polkadot/util-crypto"
      ],
      "@polkadot/keyring": [
        "./node_modules/@polkadot/keyring"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}